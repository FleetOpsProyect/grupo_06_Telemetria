# ==============================================================================
# FleetOps Telemetría — .env de PRODUCCIÓN (plantilla, SIN secretos reales)
# El archivo real vive solo en la EC2: ~/fleetops-telemetria/.env  (chmod 600)
# Nunca subir el .env real al repositorio.
# ==============================================================================

# --- Imagen que despliega el CD (IMAGE_TAG lo actualiza el pipeline) ----------
DOCKERHUB_USERNAME=juanespereira
IMAGE_TAG=sha-<commit>

# --- Aplicación ---------------------------------------------------------------
APP_NAME=fleetops-telemetria
ENVIRONMENT=production
DEBUG=False
PORT=8000
API_V1_PREFIX=/api/v1

# --- PostgreSQL (contenedor telemetria-postgres) --------------------------------
# DATABASE_URL la arma docker-compose.prod.yml con estas tres variables.
POSTGRES_DB=telemetria_db
POSTGRES_USER=telemetria_user
POSTGRES_PASSWORD=<generar: openssl rand -hex 24>

# --- Mensajería AWS SNS/SQS ------------------------------------------------------
# No van llaves de AWS: la EC2 usa el rol IAM telemetria-ec2-mensajeria.
AWS_REGION=us-east-2
SNS_TOPIC_ARN=arn:aws:sns:us-east-2:381999184349:fleetops-eventos
SQS_QUEUE_URL=https://sqs.us-east-2.amazonaws.com/381999184349/telemetria-eventos

# --- MS de Asignaciones (HU-01) --------------------------------------------------
ASSIGNMENTS_BASE_URL=<url del MS de Asignaciones>
ASSIGNMENTS_GET_PATH=/asignaciones/{asignacion_id}
ASSIGNMENTS_TIMEOUT_SECONDS=2.0

# --- Seguridad (JWT) -------------------------------------------------------------
JWT_SECRET_KEY=<generar: openssl rand -hex 32>
JWT_ALGORITHM=HS256
