# ==============================================================================
# FleetOps — Microservicio de Telemetría (Arquetipo Base)
# Variables de Entorno de Configuración (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# Aplicación FastAPI
# ------------------------------------------------------------------------------
APP_NAME=fleetops-telemetria
ENVIRONMENT=development
DEBUG=True
PORT=8000
API_V1_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# Base de Datos Relacional (PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://telemetria_user:telemetria_password@localhost:5432/telemetria_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ------------------------------------------------------------------------------
# Mensajería en AWS (SNS publica / SQS consume)
# Déjalas vacías en local: el /health mostrará broker=DISABLED y no se arrancan workers.
# NO pongas aquí la cola de producción: tu app local se llevaría mensajes de producción.
# En la EC2 las credenciales salen del rol IAM (ver deploy/.env.prod.example).
# ------------------------------------------------------------------------------
AWS_REGION=us-east-2
SNS_TOPIC_ARN=
SQS_QUEUE_URL=
# AWS_ENDPOINT_URL=http://localhost:4566   # solo si usas LocalStack
SQS_WAIT_TIME_SECONDS=20
SQS_MAX_MESSAGES=10
OUTBOX_DISPATCH_INTERVAL_SECONDS=5
MESSAGING_WORKERS_ENABLED=True

# ------------------------------------------------------------------------------
# MS de Asignaciones (HU-01: validacion sincrona antes de iniciar ruta)
# ------------------------------------------------------------------------------
ASSIGNMENTS_BASE_URL=http://localhost:8001
ASSIGNMENTS_GET_PATH=/asignaciones/{asignacion_id}
ASSIGNMENTS_TIMEOUT_SECONDS=2.0

# ------------------------------------------------------------------------------
# Parámetros del Circuit Breaker (Resiliencia)
# ------------------------------------------------------------------------------
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=30.0

# ------------------------------------------------------------------------------
# Seguridad y Autenticación Delegada (JWT)
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=dev-secret-key-change-in-production-at-all-costs-32chars
JWT_ALGORITHM=HS256
